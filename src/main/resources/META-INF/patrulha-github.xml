<idea-plugin>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.mio.irondome">
        <toolWindowTab implementation="com.mio.irondome.patrulha.PatrulhaTab"/>
        <editorCardProvider implementation="com.mio.irondome.patrulha.PullRequestCards"/>
        <editorCardProvider implementation="com.mio.irondome.patrulha.PullRequestDiscussionCards"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.mio.irondome.patrulha.ChangedLinesEditorListener"/>
        <postStartupActivity implementation="com.mio.irondome.patrulha.AutoReplyStartup"/>
    </extensions>

    <projectListeners>
        <listener class="com.mio.irondome.patrulha.ReviewBranchWatcher"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
        <listener class="com.mio.irondome.patrulha.ChangedLinesRefresher"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
        <listener class="com.mio.irondome.patrulha.ChangedLinesRefresher"
                  topic="com.mio.irondome.radar.ReviewCommentsListener"/>
    </projectListeners>
</idea-plugin>
