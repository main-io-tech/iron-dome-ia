<idea-plugin>
    <extensions defaultExtensionNs="com.mio.irondome">
        <toolWindowTab implementation="com.mio.irondome.impacto.DependencyTab"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.daemonBoundCodeVisionProvider implementation="com.mio.irondome.impacto.ImpactCodeVisionProvider"/>
        <config.codeVisionGroupSettingProvider implementation="com.mio.irondome.impacto.ImpactCodeVisionSettings"/>
        <postStartupActivity implementation="com.mio.irondome.impacto.BackgroundImpactStartup"/>
    </extensions>

    <projectListeners>
        <listener class="com.mio.irondome.impacto.ImpactRadarListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="IronDome.DependencyDiagram"
                class="com.mio.irondome.impacto.ShowDependencyDiagramAction"
                text="Iron Dome IA: Calcular Raio de Impacto"
                description="Calcula o raio de impacto da classe: quem depende dela, de quem ela depende, o risco de alterá-la e os testes que a usam"
                icon="/icons/impacto.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
            <add-to-group group-id="NavbarPopupMenu" anchor="last"/>
        </action>
        <action id="IronDome.BackgroundImpactNow"
                class="com.mio.irondome.impacto.BackgroundImpactNowAction"
                text="Iron Dome IA: Analisar Impacto das Alterações com IA Agora"
                description="A triagem confere o diff e, valendo, a IA analisa só para ler o impacto das alterações sem commit"
                icon="/icons/ia.svg"/>
    </actions>
</idea-plugin>
